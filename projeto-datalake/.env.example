# Caminho onde o arquivo ZIP (ex: movies.zip) será colocado (dentro do container)
INPUT_ZIP_DIR=/app/data/input

# Diretório raiz do Data Lake (dentro do container)
DATA_LAKE_DIR=/app/data-lake

# Chave da API do TMDB (https://www.themoviedb.org/)
TMDB_API_KEY=api_key

# Diretório base de saída dos arquivos JSON enriquecidos
OUTPUT_BASE_DIR=/app/data-lake/Raw/API/JSON/TMDB
INPUT_CSV_DIR=/app/data-lake/Raw/Local/CSV/Movies
TRUSTED_CSV_DIR=/app/data-lake/Trusted/CSV/Movies
TRUSTED_TMDB_DIR=/app/data-lake/Trusted/TMDB
RAW_TMDB_DIR=/app/data-lake/Raw/API/JSON/TMDB
REFINED_DIR=/app/data-lake/Refined
REFINED_DIM_DIR = /app/data-lake/Refined/Dim/Movies
REFINED_FACT_DIR = /app/data-lake/Refined/Fact/Financials

# Limite de arquivos JSON a serem gerados (use "ALL" para ilimitado ou um número inteiro)
MAX_JSON_FILES=ALL

# Banco de dados Postgres para controle de status da pipeline
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
